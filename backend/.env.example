# Copy this file to .env and fill in real values.

# --- Database ---
# Local dev with zero setup (default if unset): sqlite:///./syncline.db
# Production-grade: postgresql+psycopg2://syncline:syncline@localhost:5432/syncline
DATABASE_URL=sqlite:///./syncline.db

# --- Auth ---
# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of origins allowed to call this API from a browser.
# If you serve the frontend from the same origin as the API in production, you can leave this permissive for now.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# --- HubSpot OAuth (optional — leave blank to keep integrations in "not connected" state) ---
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8000/api/integrations/hubspot/callback

# --- QuickBooks Online OAuth (optional) ---
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/api/integrations/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox
